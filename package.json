{
  "name": "bupt-qq-homework-bot",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.mjs",
    "capture": "node --env-file=.env scripts/capture.mjs",
    "check": "node --env-file-if-exists=.env src/main.mjs --check",
    "demo": "node src/main.mjs --demo",
    "ai:check": "node --env-file-if-exists=.env src/main.mjs --ai-check",
    "setup:tools": "node scripts/setup-tools.mjs",
    "connect:drive": "node scripts/connect.mjs drive",
    "connect:github": "node scripts/connect.mjs github",
    "doctor": "node --env-file=.env scripts/doctor.mjs",
    "persona:learn": "node --env-file=.env scripts/learn-persona.mjs",
    "library:index": "node --env-file=.env scripts/index-library.mjs",
    "test": "node --test",
    "login:school": "node scripts/login-school.mjs",
    "history:tick": "node --env-file=.env scripts/history-tick.mjs",
    "admin:open": "node scripts/open-admin.mjs",
    "test:ui": "node scripts/check-admin-ui.mjs"
  },
  "optionalDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "cfb": "^1.2.2",
    "fflate": "^0.8.3",
    "pdf-parse": "^2.4.5"
  }
}
