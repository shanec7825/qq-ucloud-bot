# 一个学校账号，对应一个 QQ 主人；不通过 QQ 收集密码。
OWNER_QQ=
BOT_NAME=slyra
AI_BACKEND=codex
# 默认 Luna；可按账号可用模型修改，例如 gpt-6.1-sol。订阅由 codex login 登录。
CODEX_MODEL=gpt-6-luna
CODEX_BIN=codex
CAPTURE_BROWSER=chrome
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
# 逗号分隔允许响应的群号，群内需 @机器人。群内仅能读取公开作业和教材。
ALLOWED_GROUPS=
# 本机 Python 路径；用于离线音视频识别，依赖位于 tools/asr。
MEDIA_PYTHON=
SHARED_PDFS_ROOT=
SHARED_DOCUMENTS_TO_MODEL=false
GROUP_HISTORY_MODEL_GROUPS=
HISTORY_DIGEST_ENABLED=false
POLL_SECONDS=900
# 模型按需启用。BASE_URL 填到 /v1 等服务商规定的 API 根路径。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
