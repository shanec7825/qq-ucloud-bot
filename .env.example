# 一个学校账号，对应一个 QQ 主人；不通过 QQ 收集密码。
OWNER_QQ=
# 网页管理台只监听 127.0.0.1；首次启动后运行 npm run admin:open。
ADMIN_PORT=6100
BOT_NAME=slyra
AI_BACKEND=codex
# 默认 Luna；可按账号可用模型修改，例如 gpt-6.1-sol。订阅由 codex login 登录。
CODEX_MODEL=gpt-6-luna
CODEX_BIN=codex
# 模型来源：codex / api / mimo-api / mimo-token-plan-cn / deepseek / deepseek-harness。
# DeepSeek API 与 Harness 的 API Key 模式共用此密钥；可在设置页加密保存。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_HARNESS_MODEL=deepseek-flash
# api-key：使用 DeepSeek API Key；account：复用本机官方 Harness 账号登录。
DEEPSEEK_HARNESS_AUTH=api-key
# 可选：官方 dsh lib/bin.js 的完整路径；留空使用 npm run setup:deepseek 准备的组件。
DEEPSEEK_HARNESS_BIN=
CAPTURE_BROWSER=chrome
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_ACCESS_TOKEN=
# 逗号分隔允许响应的群号，群内需 @机器人。群内仅能读取公开作业和教材。
ALLOWED_GROUPS=
# 本机 Python 路径；用于离线音视频识别，依赖位于 tools/asr。
MEDIA_PYTHON=
SHARED_PDFS_ROOT=
SHARED_DOCUMENTS_TO_MODEL=false
GROUP_HISTORY_MODEL_GROUPS=
HISTORY_DIGEST_ENABLED=false
POLL_SECONDS=900
# 模型按需启用。BASE_URL 填到 /v1 等服务商规定的 API 根路径。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# 小米 MiMo Key：按量 API 使用 sk-；Token Plan 使用 tp-/ttp-。回答模型和 TTS 可共用。
MIMO_API_KEY=
